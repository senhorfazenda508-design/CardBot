# --- Bot do Discord ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# IDs do Discord com acesso total de admin do bot (opcional — dá pra
# configurar isso também pelo Painel Web, aba "Dono & permissões").
OWNER_IDS=

# Groq / OpenRouter (conversa dos NPCs e do Chat Livre da IA) — veja README.md
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=

# Modelo usado pra GERAR IMAGENS (ferramenta "gerar_imagem" do Chat Livre da
# IA — game/chatIATools.js). Usa a mesma OPENROUTER_API_KEY acima, endpoint
# dedicado /api/v1/images da OpenRouter. Padrão: google/gemini-2.5-flash-image
OPENROUTER_IMAGE_MODEL=

# --- Painel Web (web/server.js) ---
# Porta em que o painel roda (padrão 3000)
PANEL_PORT=3000
# Segredo usado pra assinar o cookie de sessão do painel — troque por um
# valor aleatório antes de colocar em produção (ex: gere com
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
PANEL_SESSION_SECRET=troque-esse-segredo
