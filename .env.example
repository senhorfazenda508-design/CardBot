# --- Bot do Discord ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# IDs do Discord com acesso total de admin do bot (opcional — dá pra
# configurar isso também pelo Painel Web, aba "Dono & permissões").
OWNER_IDS=

# DeepSeek (conversa dos NPCs, Chat Livre e Narrador com IA) — veja README.md
# Chave em https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Opcional — padrão é deepseek-flash
DEEPSEEK_MODEL=

# --- Painel Web (web/server.js) ---
# Porta em que o painel roda (padrão 3000)
PANEL_PORT=3000
# Segredo usado pra assinar o cookie de sessão do painel — troque por um
# valor aleatório antes de colocar em produção (ex: gere com
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
PANEL_SESSION_SECRET=troque-esse-segredo
